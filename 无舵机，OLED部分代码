#include <Servo.h>

#define SERVO_PIN 9
#define LED1 2
#define LED2 3
#define BUZZER 4
#define BUTTON_PIN 5

Servo myServo;
int receivedNum = 0;
bool isTriggered = false;

void setup() {
  Serial.begin(9600);
  myServo.attach(SERVO_PIN);
  myServo.write(0);
  
  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  pinMode(BUZZER, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
}

void loop() {
  int buttonState = digitalRead(BUTTON_PIN);
  
  // 按钮复位逻辑
  if(buttonState == LOW && isTriggered) {
    delay(50);
    if(buttonState == LOW) {
      myServo.write(0);
      digitalWrite(LED1, LOW);
      digitalWrite(LED2, LOW);
      digitalWrite(BUZZER, LOW);
      isTriggered = false;
    }
  }

  // 串口触发逻辑
  if(Serial.available() > 0 && !isTriggered) {
    receivedNum = Serial.parseInt();
    Serial.print("Received: ");
    Serial.println(receivedNum);
    if(receivedNum > 800) {
      isTriggered = true;
      myServo.write(90);
    }
  }

  // 触发后的报警逻辑
  if(isTriggered) {
    digitalWrite(LED1, HIGH);
    digitalWrite(LED2, LOW);
    digitalWrite(BUZZER, HIGH);
    delay(200);
    digitalWrite(LED1, LOW);
    digitalWrite(LED2, HIGH);
    digitalWrite(BUZZER, LOW);
    delay(200);
  }
}
