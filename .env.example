# ================== Joker Detector Pro 统一配置模板 ==================
# 使用步骤：
#   1. 把本文件复制为同目录下的 .env
#   2. 把 DEEPSEEK_API_KEY 换成项目统一的那把 Key
#   3. 启动服务（或已在运行时到网页「墨设」点「重新加载配置」）
#
# .env 已被 .gitignore 排除，不会被提交；正式对外分发时请手动把 .env
# 随包提供给使用者，或改用真实的环境变量。
# 不配置则退化为纯算法模式（无需 API，功能照常，只是没有云端长文）。

# DeepSeek / OpenAI 兼容 API 配置
DEEPSEEK_API_KEY=your-api-key-here           # 项目统一使用的 API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com   # API 地址（DeepSeek / OpenAI / 任意兼容服务）
DEEPSEEK_MODEL=deepseek-chat                 # 模型名称（deepseek-chat / gpt-4o / 等）

# 说明：硬件联动（Arduino 串口）已移除，相关代码与固件归档在 archive/arduino_integration/
